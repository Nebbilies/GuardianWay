  TripPassengerByStudentId               TripPassenger[]         @relation("TripPassenger_studentId")
  StudentTransferByStudentId             StudentTransfer[]       @relation("StudentTransfer_studentId")
  AttendanceEventByStudentId             AttendanceEvent[]       @relation("AttendanceEvent_studentId")
  AttendanceRevisionByEffectiveStudentId AttendanceRevision[]    @relation("AttendanceRevision_effectiveStudentId")
  StudentTripResolutionByStudentId       StudentTripResolution[] @relation("StudentTripResolution_studentId")
  ReconciliationItemByStudentId          ReconciliationItem[]    @relation("ReconciliationItem_studentId")
