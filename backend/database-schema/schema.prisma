// Target database foundation; the active application still uses prisma/schema.prisma. Status/domain fields are text.
generator client {
  provider = "prisma-client-js"
  output = "../generated/database-client"
}

datasource db {
  provider = "postgresql"
}

model School {
  id                               String                   @id(map: "pk_school") @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  code                             String                   @map("code") @db.Text
  name                             String                   @map("name") @db.Text
  address                          String                   @map("address") @db.Text
  contactPhone                     String?                  @map("contact_phone") @db.Text
  contactEmail                     String?                  @map("contact_email") @db.Text
  timezone                         String                   @map("timezone") @db.Text
  status                           String                   @map("status") @db.Text
  createdAt                        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                        DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt                        DateTime?                @map("deleted_at") @db.Timestamptz(3)
  SchoolPolicyVersionBySchoolId    SchoolPolicyVersion[]    @relation("SchoolPolicyVersion_schoolId")
  UserAccountBySchoolId            UserAccount[]            @relation("UserAccount_schoolId")
  UserInviteBySchoolId             UserInvite[]             @relation("UserInvite_schoolId")
  RefreshTokenBySchoolId           RefreshToken[]           @relation("RefreshToken_schoolId")
  AuditLogBySchoolId               AuditLog[]               @relation("AuditLog_schoolId")
  DriverProfileBySchoolId          DriverProfile[]          @relation("DriverProfile_schoolId")
  VehicleBySchoolId                Vehicle[]                @relation("Vehicle_schoolId")
  StudentBySchoolId                Student[]                @relation("Student_schoolId")
  GuardianLinkBySchoolId           GuardianLink[]           @relation("GuardianLink_schoolId")
  StudentCardAssignmentBySchoolId  StudentCardAssignment[]  @relation("StudentCardAssignment_schoolId")
  ServiceRegistrationBySchoolId    ServiceRegistration[]    @relation("ServiceRegistration_schoolId")
  RegistrationDayBySchoolId        RegistrationDay[]        @relation("RegistrationDay_schoolId")
  AbsenceRequestBySchoolId         AbsenceRequest[]         @relation("AbsenceRequest_schoolId")
  StopChangeRequestBySchoolId      StopChangeRequest[]      @relation("StopChangeRequest_schoolId")
  StopBySchoolId                   Stop[]                   @relation("Stop_schoolId")
  PlanVersionBySchoolId            PlanVersion[]            @relation("PlanVersion_schoolId")
  PlanDemandBySchoolId             PlanDemand[]             @relation("PlanDemand_schoolId")
  PlannedRouteBySchoolId           PlannedRoute[]           @relation("PlannedRoute_schoolId")
  PlannedStopBySchoolId            PlannedStop[]            @relation("PlannedStop_schoolId")
  PlannedPassengerBySchoolId       PlannedPassenger[]       @relation("PlannedPassenger_schoolId")
  PlanFindingBySchoolId            PlanFinding[]            @relation("PlanFinding_schoolId")
  RecurringScheduleBySchoolId      RecurringSchedule[]      @relation("RecurringSchedule_schoolId")
  ScheduleWeekdayBySchoolId        ScheduleWeekday[]        @relation("ScheduleWeekday_schoolId")
  TripBySchoolId                   Trip[]                   @relation("Trip_schoolId")
  TripStopBySchoolId               TripStop[]               @relation("TripStop_schoolId")
  TripPassengerBySchoolId          TripPassenger[]          @relation("TripPassenger_schoolId")
  TripAssignmentBySchoolId         TripAssignment[]         @relation("TripAssignment_schoolId")
  StudentTransferBySchoolId        StudentTransfer[]        @relation("StudentTransfer_schoolId")
  AttendanceEventBySchoolId        AttendanceEvent[]        @relation("AttendanceEvent_schoolId")
  AttendanceRevisionBySchoolId     AttendanceRevision[]     @relation("AttendanceRevision_schoolId")
  StudentTripResolutionBySchoolId  StudentTripResolution[]  @relation("StudentTripResolution_schoolId")
  TripReconciliationBySchoolId     TripReconciliation[]     @relation("TripReconciliation_schoolId")
  ReconciliationItemBySchoolId     ReconciliationItem[]     @relation("ReconciliationItem_schoolId")
  TrackingSessionBySchoolId        TrackingSession[]        @relation("TrackingSession_schoolId")
  GpsPositionBySchoolId            GpsPosition[]            @relation("GpsPosition_schoolId")
  NotificationBySchoolId           Notification[]           @relation("Notification_schoolId")
  NotificationRecipientBySchoolId  NotificationRecipient[]  @relation("NotificationRecipient_schoolId")
  PushEndpointBySchoolId           PushEndpoint[]           @relation("PushEndpoint_schoolId")
  PushDeliveryBySchoolId           PushDelivery[]           @relation("PushDelivery_schoolId")
  ReconciliationEvidenceBySchoolId ReconciliationEvidence[] @relation("ReconciliationEvidence_schoolId")

  @@unique([code], map: "uq_school_code")
  @@map("school")
}

model SchoolPolicyVersion {
  id                                     String                @id(map: "pk_school_policy_version") @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  schoolId                               String                @map("school_id") @db.Uuid
  versionNo                              Int                   @map("version_no")
  previousVersionId                      String?               @map("previous_version_id") @db.Uuid
  effectiveFrom                          DateTime              @map("effective_from") @db.Timestamptz(3)
  effectiveTo                            DateTime?             @map("effective_to") @db.Timestamptz(3)
  pickupArrivalTime                      DateTime?             @map("pickup_arrival_time") @db.Time(0)
  dropoffDepartureTime                   DateTime?             @map("dropoff_departure_time") @db.Time(0)
  rideWarningMinutes                     Float?                @map("ride_warning_minutes") @db.DoublePrecision
  pickupWaitMinutes                      Float?                @map("pickup_wait_minutes") @db.DoublePrecision
  gpsStaleSeconds                        Int?                  @map("gps_stale_seconds")
  historyRetentionDays                   Int?                  @map("history_retention_days")
  approvedById                           String?               @map("approved_by_id") @db.Uuid
  approvedAt                             DateTime?             @map("approved_at") @db.Timestamptz(3)
  approvalBasis                          String?               @map("approval_basis") @db.Text
  status                                 String                @map("status") @db.Text
  createdAt                              DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                              DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  schoolIdRef                            School                @relation("SchoolPolicyVersion_schoolId", fields: [schoolId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_school_policy_version_school_id")
  previousVersionIdRef                   SchoolPolicyVersion?  @relation("SchoolPolicyVersion_previousVersionId", fields: [schoolId, previousVersionId], references: [schoolId, id], onDelete: Restrict, onUpdate: Restrict, map: "fk_school_policy_version_previous_version_id")
  SchoolPolicyVersionByPreviousVersionId SchoolPolicyVersion[] @relation("SchoolPolicyVersion_previousVersionId")
  approvedByIdRef                        UserAccount?          @relation("SchoolPolicyVersion_approvedById", fields: [approvedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_school_policy_version_approved_by_id")
  PlanVersionByPolicyVersionId           PlanVersion[]         @relation("PlanVersion_policyVersionId")
  TripByOperatingPolicyId                Trip[]                @relation("Trip_operatingPolicyId")

  @@unique([schoolId, versionNo], map: "uq_school_policy_version_school_id_version_no")
  @@unique([schoolId, id], map: "uq_school_policy_version_school_id_id")
  @@index([schoolId, effectiveFrom], map: "ix_school_policy_version_1")
  @@map("school_policy_version")
}

model UserAccount {
  id                                   String                  @id(map: "pk_user_account") @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  schoolId                             String?                 @map("school_id") @db.Uuid
  email                                String                  @map("email") @db.Text
  displayName                          String                  @map("display_name") @db.Text
  phone                                String?                 @map("phone") @db.Text
  passwordHash                         String?                 @map("password_hash") @db.Text
  role                                 String                  @map("role") @db.Text
  status                               String                  @map("status") @db.Text
  activatedAt                          DateTime?               @map("activated_at") @db.Timestamptz(3)
  createdAt                            DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                            DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt                            DateTime?               @map("deleted_at") @db.Timestamptz(3)
  SchoolPolicyVersionByApprovedById    SchoolPolicyVersion[]   @relation("SchoolPolicyVersion_approvedById")
  schoolIdRef                          School?                 @relation("UserAccount_schoolId", fields: [schoolId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_user_account_school_id")
  UserInviteByAccountId                UserInvite[]            @relation("UserInvite_accountId")
  UserInviteByInvitedById              UserInvite[]            @relation("UserInvite_invitedById")
  RefreshTokenByAccountId              RefreshToken[]          @relation("RefreshToken_accountId")
  AuditLogByActorId                    AuditLog[]              @relation("AuditLog_actorId")
  DriverProfileByAccountId             DriverProfile[]         @relation("DriverProfile_accountId")
  GuardianLinkByGuardianAccountId      GuardianLink[]          @relation("GuardianLink_guardianAccountId")
  GuardianLinkByConfirmedById          GuardianLink[]          @relation("GuardianLink_confirmedById")
  StudentCardAssignmentByAssignedById  StudentCardAssignment[] @relation("StudentCardAssignment_assignedById")
  StudentCardAssignmentByRevokedById   StudentCardAssignment[] @relation("StudentCardAssignment_revokedById")
  ServiceRegistrationBySubmittedById   ServiceRegistration[]   @relation("ServiceRegistration_submittedById")
  ServiceRegistrationByReviewedById    ServiceRegistration[]   @relation("ServiceRegistration_reviewedById")
  AbsenceRequestBySubmittedById        AbsenceRequest[]        @relation("AbsenceRequest_submittedById")
  AbsenceRequestByProcessedById        AbsenceRequest[]        @relation("AbsenceRequest_processedById")
  StopChangeRequestBySubmittedById     StopChangeRequest[]     @relation("StopChangeRequest_submittedById")
  StopChangeRequestByReviewedById      StopChangeRequest[]     @relation("StopChangeRequest_reviewedById")
  PlanVersionByCreatedById             PlanVersion[]           @relation("PlanVersion_createdById")
  PlanVersionByApprovedById            PlanVersion[]           @relation("PlanVersion_approvedById")
  PlanFindingByAcceptedById            PlanFinding[]           @relation("PlanFinding_acceptedById")
  RecurringScheduleByCreatedById       RecurringSchedule[]     @relation("RecurringSchedule_createdById")
  TripByStartedById                    Trip[]                  @relation("Trip_startedById")
  TripByCancelledById                  Trip[]                  @relation("Trip_cancelledById")
  TripStopByChangedById                TripStop[]              @relation("TripStop_changedById")
  TripPassengerByChangedById           TripPassenger[]         @relation("TripPassenger_changedById")
  TripAssignmentByAssignedById         TripAssignment[]        @relation("TripAssignment_assignedById")
  StudentTransferByConfirmedById       StudentTransfer[]       @relation("StudentTransfer_confirmedById")
  AttendanceEventByRecordedById        AttendanceEvent[]       @relation("AttendanceEvent_recordedById")
  AttendanceRevisionByCorrectedById    AttendanceRevision[]    @relation("AttendanceRevision_correctedById")
  StudentTripResolutionByResolvedById  StudentTripResolution[] @relation("StudentTripResolution_resolvedById")
  TripReconciliationByPerformedById    TripReconciliation[]    @relation("TripReconciliation_performedById")
  TripReconciliationByVehicleCheckById TripReconciliation[]    @relation("TripReconciliation_vehicleCheckById")
  TrackingSessionBySourceAccountId     TrackingSession[]       @relation("TrackingSession_sourceAccountId")
  NotificationByActorId                Notification[]          @relation("Notification_actorId")
  NotificationRecipientByAccountId     NotificationRecipient[] @relation("NotificationRecipient_accountId")
  PushEndpointByAccountId              PushEndpoint[]          @relation("PushEndpoint_accountId")

  @@unique([email], map: "uq_user_account_email")
  @@unique([schoolId, id], map: "uq_user_account_school_id_id")
  @@index([schoolId, role, status], map: "ix_user_account_1")
  @@map("user_account")
}

model UserInvite {
  id             String      @id(map: "pk_user_invite") @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  schoolId       String      @map("school_id") @db.Uuid
  accountId      String      @map("account_id") @db.Uuid
  invitedById    String      @map("invited_by_id") @db.Uuid
  tokenHash      String      @map("token_hash") @db.Text
  issuedAt       DateTime    @map("issued_at") @db.Timestamptz(3)
  expiresAt      DateTime    @map("expires_at") @db.Timestamptz(3)
  acceptedAt     DateTime?   @map("accepted_at") @db.Timestamptz(3)
  revokedAt      DateTime?   @map("revoked_at") @db.Timestamptz(3)
  status         String      @map("status") @db.Text
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  schoolIdRef    School      @relation("UserInvite_schoolId", fields: [schoolId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_user_invite_school_id")
  accountIdRef   UserAccount @relation("UserInvite_accountId", fields: [schoolId, accountId], references: [schoolId, id], onDelete: Restrict, onUpdate: Restrict, map: "fk_user_invite_account_id")
  invitedByIdRef UserAccount @relation("UserInvite_invitedById", fields: [invitedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_user_invite_invited_by_id")

  @@unique([tokenHash], map: "uq_user_invite_token_hash")
  @@unique([schoolId, id], map: "uq_user_invite_school_id_id")
  @@index([schoolId, accountId, createdAt(sort: Desc)], map: "ix_user_invite_1")
  @@map("user_invite")
}

model RefreshToken {
  id           String      @id(map: "pk_refresh_token") @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  schoolId     String?     @map("school_id") @db.Uuid
  accountId    String      @map("account_id") @db.Uuid
  tokenHash    String      @map("token_hash") @db.Text
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt    DateTime    @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime?   @map("revoked_at") @db.Timestamptz(3)
  userAgent    String?     @map("user_agent") @db.Text
  updatedAt    DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  ipAddress    String?     @map("ip_address") @db.Text
  schoolIdRef  School?     @relation("RefreshToken_schoolId", fields: [schoolId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_refresh_token_school_id")
  accountIdRef UserAccount @relation("RefreshToken_accountId", fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_refresh_token_account_id")

  @@unique([tokenHash], map: "uq_refresh_token_token_hash")
  @@unique([schoolId, id], map: "uq_refresh_token_school_id_id")
  @@index([accountId, revokedAt, expiresAt], map: "ix_refresh_token_1")
  @@map("refresh_token")
}

model AuditLog {
  id                String        @id(map: "pk_audit_log") @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  schoolId          String?       @map("school_id") @db.Uuid
  actorId           String?       @map("actor_id") @db.Uuid
  notificationId    String?       @map("notification_id") @db.Uuid
  action            String        @map("action") @db.Text
  subjectKind       String        @map("subject_kind") @db.Text
  subjectReference  String        @map("subject_reference") @db.Text
  occurredAt        DateTime      @map("occurred_at") @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  reason            String?       @map("reason") @db.Text
  changeSummary     Json          @map("change_summary") @db.JsonB
  operationKey      String        @map("operation_key") @db.Text
  schoolIdRef       School?       @relation("AuditLog_schoolId", fields: [schoolId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_audit_log_school_id")
  actorIdRef        UserAccount?  @relation("AuditLog_actorId", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_audit_log_actor_id")
  notificationIdRef Notification? @relation("AuditLog_notificationId", fields: [notificationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_audit_log_notification_id")

  @@unique([schoolId, id], map: "uq_audit_log_school_id_id")
  @@index([schoolId, createdAt(sort: Desc), id(sort: Desc)], map: "ix_audit_log_1")
  @@map("audit_log")
}

model DriverProfile {
  id                                 String              @id(map: "pk_driver_profile") @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  schoolId                           String              @map("school_id") @db.Uuid
  code                               String              @map("code") @db.Text
  accountId                          String?             @map("account_id") @db.Uuid
  fullName                           String              @map("full_name") @db.Text
  phone                              String              @map("phone") @db.Text
  status                             String              @map("status") @db.Text
  notes                              String?             @map("notes") @db.Text
  createdAt                          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                          DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt                          DateTime?           @map("deleted_at") @db.Timestamptz(3)
  schoolIdRef                        School              @relation("DriverProfile_schoolId", fields: [schoolId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_driver_profile_school_id")
  accountIdRef                       UserAccount?        @relation("DriverProfile_accountId", fields: [schoolId, accountId], references: [schoolId, id], onDelete: Restrict, onUpdate: Restrict, map: "fk_driver_profile_account_id")
  RecurringScheduleByDefaultDriverId RecurringSchedule[] @relation("RecurringSchedule_defaultDriverId")
  TripByInitialDriverId              Trip[]              @relation("Trip_initialDriverId")
  TripAssignmentByDriverId           TripAssignment[]    @relation("TripAssignment_driverId")

  @@unique([accountId], map: "uq_driver_profile_account_id")
  @@unique([schoolId, id], map: "uq_driver_profile_school_id_id")
  @@map("driver_profile")
}

model Vehicle {
  id                                  String              @id(map: "pk_vehicle") @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  schoolId                            String              @map("school_id") @db.Uuid
  code                                String              @map("code") @db.Text
  plateNumber                         String              @map("plate_number") @db.Text
  studentCapacity                     Int                 @map("student_capacity")
  status                              String              @map("status") @db.Text
  description                         String?             @map("description") @db.Text
  createdAt                           DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                           DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt                           DateTime?           @map("deleted_at") @db.Timestamptz(3)
  schoolIdRef                         School              @relation("Vehicle_schoolId", fields: [schoolId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_vehicle_school_id")
  PlannedRouteByVehicleId             PlannedRoute[]      @relation("PlannedRoute_vehicleId")
  RecurringScheduleByDefaultVehicleId RecurringSchedule[] @relation("RecurringSchedule_defaultVehicleId")
  TripByInitialVehicleId              Trip[]              @relation("Trip_initialVehicleId")
  TripAssignmentByVehicleId           TripAssignment[]    @relation("TripAssignment_vehicleId")

  @@unique([schoolId, id], map: "uq_vehicle_school_id_id")
  @@map("vehicle")
}

