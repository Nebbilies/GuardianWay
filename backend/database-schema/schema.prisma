  effectiveFrom            DateTime       @map("effective_from") @db.Timestamptz(3)
  effectiveTo              DateTime?      @map("effective_to") @db.Timestamptz(3)
  revocationReason         String?        @map("revocation_reason") @db.Text
  createdAt                DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  schoolIdRef              School         @relation("PushEndpoint_schoolId", fields: [schoolId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_push_endpoint_school_id")
  accountIdRef             UserAccount    @relation("PushEndpoint_accountId", fields: [schoolId, accountId], references: [schoolId, id], onDelete: Restrict, onUpdate: Restrict, map: "fk_push_endpoint_account_id")
  PushDeliveryByEndpointId PushDelivery[] @relation("PushDelivery_endpointId")

  @@unique([schoolId, id], map: "uq_push_endpoint_school_id_id")
  @@map("push_endpoint")
}

