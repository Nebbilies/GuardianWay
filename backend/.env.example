# New local schema target; production/container deployments supply their explicit DATABASE_URL.
DATABASE_URL="postgresql://gw:replace-me@127.0.0.1:55432/guardianway_dev"
# Local runner sets both URLs to its validated SCHEMA_DATABASE_URL target.
DIRECT_URL="postgresql://gw:replace-me@127.0.0.1:55432/guardianway_dev"

# Redis (containerized via docker-compose service name "redis"), non-TLS
REDIS_URL="redis://redis:6379"
# Set false for local development without Redis; rate limits use process memory.
REDIS_ENABLED=true

# Auth — generate with: openssl rand -hex 32
JWT_ACCESS_SECRET="replace-me"
JWT_REFRESH_SECRET="replace-me"

# Public origin users reach the app on (CORS allow-origin + invite-link base).
# Behind the nginx proxy this is the nginx port (8080), NOT the raw frontend port.
WEB_BASE_URL="http://localhost:8080"

# Mailer for password-setup invites. EMAIL_PASSWORD is a Gmail app password
# (Google Account -> Security -> 2-Step Verification -> App passwords), which
# bypasses 2FA and grants send-as plus mailbox access. Keep it out of git; in CI
# it comes from the EMAIL_PASSWORD repository secret.
EMAIL_USERNAME="replace-me@example.com"
EMAIL_PASSWORD="replace-me"

# Number of reverse proxies in front of the backend, for Express's trust-proxy
# hop count (governs which X-Forwarded-For entry req.ip trusts). Compose runs
# nginx in front, so 1; k8s has no proxy in the request path, so 0. Unset falls
# back to 0.
TRUST_PROXY_HOPS=1

# Explicit app bootstrap. Passwords must have at least 12 characters; no seed password is shipped.
BOOTSTRAP_PLATFORM_EMAIL=platform@example.test
BOOTSTRAP_PLATFORM_PASSWORD=
# Optional demo school admin: supply both values when needed.
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_SCHOOL_CODE=DEMO

# Worktree-local runner configuration (optional paths; ignored env files are never auto-copied).
# GUARDIANWAY_APP_ENV_FILE=D:/chosen-checkout/backend/.env
# GUARDIANWAY_SCHEMA_ENV_FILE=D:/chosen-checkout/database/.env
