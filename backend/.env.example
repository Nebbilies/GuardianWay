# Postgres (containerized via docker-compose service name "postgres")
DATABASE_URL="postgresql://gw:gw_pw@postgres:5432/guardianway"
# No connection pooler in self-hosted setup, so DIRECT_URL == DATABASE_URL
DIRECT_URL="postgresql://gw:gw_pw@postgres:5432/guardianway"

# Redis (containerized via docker-compose service name "redis"), non-TLS
REDIS_URL="redis://redis:6379"

# Auth — generate with: openssl rand -hex 32
JWT_ACCESS_SECRET="replace-me"
JWT_REFRESH_SECRET="replace-me"

# Public origin users reach the app on (CORS allow-origin + invite-link base).
# Behind the nginx proxy this is the nginx port (8080), NOT the raw frontend port.
WEB_BASE_URL="http://localhost:8080"

# Mailer for password-setup invites. EMAIL_PASSWORD is a Gmail app password
# (Google Account -> Security -> 2-Step Verification -> App passwords), which
# bypasses 2FA and grants send-as plus mailbox access. Keep it out of git; in CI
# it comes from the EMAIL_PASSWORD repository secret.
EMAIL_USERNAME="replace-me@example.com"
EMAIL_PASSWORD="replace-me"

# Number of reverse proxies in front of the backend, for Express's trust-proxy
# hop count (governs which X-Forwarded-For entry req.ip trusts). Compose runs
# nginx in front, so 1; k8s has no proxy in the request path, so 0. Unset falls
# back to 0.
TRUST_PROXY_HOPS=1
