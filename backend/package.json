{
  "name": "@gw/backend",
  "version": "1.0.0",
  "description": "",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "node scripts/database-command.cjs dev:app",
    "seed": "npm run database:seed:demo",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test:database-schema": "vitest run --config vitest.database-schema.config.ts",
    "database:validate": "prisma validate --config prisma.config.ts",
    "database:generate": "prisma generate --config prisma.config.ts",
    "dev:app": "ts-node-dev --respawn --transpile-only src/index.ts",
    "database:migrate": "prisma migrate deploy --config prisma.config.ts",
    "database:seed": "node prisma/seed-demo.cjs",
    "database:migrate:demo": "node scripts/database-command.cjs database:migrate",
    "database:seed:demo": "node scripts/database-command.cjs database:seed",
    "test:architecture": "vitest run --config vitest.architecture.config.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.7.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^8.0.10",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prisma": "^7.7.0",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^6.0.0",
    "redis": "^5.11.0",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.0.4",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^8.0.0",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "testcontainers": "^12.0.4",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.2",
    "vitest": "^3.0.0"
  }
}
